# Shared configuration for Claude Code, Codex, and OpenCode.
protocol = "2.1.0"

[paths]
handoffs = "ai_handoffs"
ledger = "AI_COLLABORATION.md"

[roles]
mode = "dynamic"             # Review-handoff initiator owns the writer role.
preferred_reviewers = ["claude", "codex"] # Explicit request wins; otherwise first other eligible agent.
producers = []
# Legacy mode = "fixed" keeps implementer/reviewers plus reviewer.identity.
# Do not include those static pins in dynamic mode. See reference/review-routing.md.

[review_policy]
trigger = "requested"         # requested | completion (explicit opt-in)
max_rounds = 1               # Includes confirmation rounds.
confirmation_after_fixes = false

[guards]
min_bytes = 200

# Role and fresh run ID are resolved at invocation. Preserve historical
# artifact headers when these settings change.
[agents.claude]
token = "claude"
model_family = "claude"
attestation = "Author: Claude Code ({role} {run_id})"
cli = """claude -p --output-format text --tools Read,Grep,Glob --permission-mode plan --strict-mcp-config --mcp-config '{"mcpServers":{}}'"""
output_mode = "stdout_redirect"
blocking_authority = true

[agents.codex]
token = "codex"
model_family = "gpt"
attestation = "Author: Codex ({role} {run_id})"
cli = "codex exec --skip-git-repo-check -s {sandbox} -C {repo} -o {output} -"
output_mode = "file_arg"
blocking_authority = true

[agents.reviewer]
token = "reviewer"
# Fill host with the actual invoking host; native agent is a separate run.
attestation = "Author: {host} Reviewer ({role} {run_id})"

# OpenCode can implement, review, or produce. When selected, add a concrete
# [agents.opencode] entry using reference/opencode.md: declare its token,
# attestation, provider/model, and opencode_run.py CLI with stdout_redirect.
# Use the restricted agent-collab-reviewer for reviews; choose a separately
# configured worker agent for production. The host name alone does not
# establish model-vendor independence. Do not leave a placeholder model active.

[reviewer]
mode = "subagent-cli"         # subagent | subagent-cli | dispatch
# Identity comes from per-cycle resolution, not a permanent assignment.
# A transport fallback must retain the selected reviewer/model; never silently
# replace an explicit request with another identity.
sandbox = "read-only"
timeout_sec = 1800
escalate = []                 # Optional classes requiring cross-vendor review.
# Existing project runners may supply dispatch_cmd and dispatch_watch.

# Optional agents.<key>.aliases = ["my-reviewer"] and model = "provider/model"
# map explicit requests to configured routes. Record actual models at dispatch;
# an agent host name alone does not prove model-vendor independence.

# CLI examples above are for review. Customize capabilities deliberately for
# producer stages. Never infer permission to run an implementation agent from
# a reviewer command. Prompts go through stdin, not shell interpolation.

# Optional council: collab-init omits this section until a task is specified.
# [council]
# run_dir = "ai_handoffs/.council"
#
# [council.stages.assess]
# agent = "codex"
# role = "reviewer"
# prompt = "prompts/assessment.md"
# after = []
# output = "ai_handoffs/{ts}-codex-assess-{cycle}.md"
# output_mode = "file_arg"
# timeout_sec = 1800
#
# Shell stages use type = "shell", command, after, and timeout_sec.
# Validate prompts, acyclic dependencies, unique output paths, and runtime
# capabilities before dispatching. See reference/hosts.md.
